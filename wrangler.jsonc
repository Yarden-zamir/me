// Cloudflare Worker that serves the built Obsidian site as static assets.
// The CI workflow builds the site into ../public (next to this vault checkout).
{
  "$schema": "https://unpkg.com/wrangler@4.144.0/config-schema.json",
  "name": "yarden-zamir-site",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    // The apex yarden-zamir.com redirects to www through a zone redirect rule, not through this Worker.
    { "pattern": "www.yarden-zamir.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../public",
    "not_found_handling": "404-page"
  }
}
